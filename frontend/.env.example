# Wasl frontend. Only PUBLIC values belong here — never provider keys.
NEXT_PUBLIC_API_URL=http://localhost:8000
# local | supabase  (must match backend AUTH_MODE)
NEXT_PUBLIC_AUTH_MODE=local
# Only for AUTH_MODE=supabase (Project Settings -> API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
