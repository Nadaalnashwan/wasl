# Wasl frontend. Only PUBLIC values belong here — never provider keys.
# Local default. In production: the deployed backend URL (Vercel env).
NEXT_PUBLIC_API_URL=http://localhost:8000
# local | supabase  (must match backend AUTH_MODE)
NEXT_PUBLIC_AUTH_MODE=local
# Only for AUTH_MODE=supabase (Project Settings -> API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the publishable key; the legacy anon key is used if it is empty.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Server-only backend URL used by the /admin gate (src/lib/admin-session.ts); falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=
# Optional label shown in the admin console header.
NEXT_PUBLIC_APP_ENV=
