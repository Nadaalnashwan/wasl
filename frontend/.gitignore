# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python / Backend
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Local databases
*.db
*.sqlite
*.sqlite3

# Next.js / Frontend
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Testing
coverage/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor
.DS_Store
Thumbs.db

# Certificates
*.pem
*.key

# Deployment
.vercel/

# Local uploads
backend/uploads/
