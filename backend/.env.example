# ============================================================================
# Wasl backend configuration. Copy to backend/.env and fill in. NEVER commit .env
# ============================================================================

# --- core -------------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- database ---------------------------------------------------------------
# Leave empty for local SQLite (backend/wasl.db). For Supabase Postgres use the
# Session pooler connection string (Project -> Connect), with the psycopg driver:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- auth -------------------------------------------------------------------
# local    = backend issues its own JWTs (demo / development)
# supabase = frontend uses Supabase Auth; backend verifies Supabase tokens
AUTH_MODE=local
# >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
SUPABASE_URL=
# Only needed for legacy HS256 projects (Settings -> API -> JWT Secret). New projects use JWKS automatically.
SUPABASE_JWT_SECRET=
# Server-only. Used for Supabase Storage uploads. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wasl-uploads

# --- encryption of stored user API keys + OAuth tokens -----------------------
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- platform AI providers (server side only) --------------------------------
# Groq free key:   https://console.groq.com/keys
GROQ_API_KEY=
# Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional:        https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_PROVIDER_PRIORITY=groq,gemini,openrouter
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
GEMINI_MODEL_FAST=gemini-3.5-flash
GEMINI_MODEL_QUALITY=gemini-3.5-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# test-only deterministic provider; keep false
AI_ENABLE_FAKE_PROVIDER=false

# --- LinkedIn (https://www.linkedin.com/developers/apps) ----------------------
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202509

# --- GitHub OAuth App (https://github.com/settings/developers) ----------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback
# read:user = public repos only. Add "repo" to read private repos (note: broad scope).
GITHUB_SCOPES=read:user
GITHUB_MAX_REPOS_PER_SCAN=10

# --- uploads & PDF fonts ----------------------------------------------------
MAX_UPLOAD_MB=5
# Optional: a TTF with Arabic glyphs for PDF export (defaults to system Arial / DejaVu)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# --- monitoring alert thresholds -------------------------------------------
ALERT_FAILURE_RATE=0.2
ALERT_P95_LATENCY_MS=15000
ALERT_UNSUPPORTED_CLAIM_RATE=0.1
ALERT_FALLBACK_RATE=0.3
