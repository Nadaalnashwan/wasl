# ============================================================================
# Wasl backend configuration. Copy to backend/.env and fill in. NEVER commit .env
# ============================================================================

# --- core -------------------------------------------------------------------
APP_ENV=development
# Local defaults. In production set these to the deployed frontend/backend origins (see HANDOFF.md §4).
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- database ---------------------------------------------------------------
# Leave empty for local SQLite (backend/wasl.db). For Supabase Postgres use the
# Session pooler connection string (Project -> Connect), with the psycopg driver:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- auth -------------------------------------------------------------------
# local    = backend issues its own JWTs (demo / development)
# supabase = frontend uses Supabase Auth; backend verifies Supabase tokens
AUTH_MODE=local
# >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
SUPABASE_URL=
# Only needed for legacy HS256 projects (Settings -> API -> JWT Secret). New projects use JWKS automatically.
SUPABASE_JWT_SECRET=
# Server-only. Used for Supabase Storage uploads. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wasl-uploads

# --- encryption of stored user API keys + OAuth tokens -----------------------
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- platform AI providers (server side only) --------------------------------
# Groq free key:   https://console.groq.com/keys
GROQ_API_KEY=
# Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional:        https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_PROVIDER_PRIORITY=groq,gemini,openrouter
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
# gemini-3.5-flash is NOT a listed model id; defaults verified 2026-11-24 (docs/AI_MODEL_REGISTRY.md)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-3.8-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_TOTAL_DEADLINE_SECONDS=120
# --- AI privacy policy (docs/PRIVACY.md) ---
AI_PERSONAL_MIN_PRIVACY=limited_retention
# Operator attestations: set true ONLY after verifying the provider account configuration and terms
GROQ_ZDR_ENABLED=false
GEMINI_PAID_TIER=false
# Never disable in production
AI_REDACT_PII=true
# test-only deterministic provider; keep false
AI_ENABLE_FAKE_PROVIDER=false

# --- LinkedIn (https://www.linkedin.com/developers/apps) ----------------------
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202609

# --- GitHub OAuth App (https://github.com/settings/developers) ----------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/integrations/github/callback
# read:user = public repos only. Add "repo" to read private repos (note: broad scope).
GITHUB_SCOPES=read:user
GITHUB_MAX_REPOS_PER_SCAN=10

# --- uploads & PDF fonts ----------------------------------------------------
MAX_UPLOAD_MB=5
# Optional: a TTF with Arabic glyphs for PDF export (defaults to system Arial / DejaVu)
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# --- monitoring alert thresholds -------------------------------------------
# Defaults from app/config.py; rationale in docs/MONITORING.md
ALERT_FAILURE_RATE=0.1
ALERT_P95_LATENCY_MS=20000
ALERT_UNSUPPORTED_CLAIM_RATE=0.08
ALERT_FALLBACK_RATE=0.25
ALERT_RATE_LIMIT_COUNT=10
ALERT_DAILY_COST_USD=5.0
ALERT_MIN_SAMPLE=20
ALERT_COOLDOWN_MINUTES=60
# In-process scheduler (DB lease: one evaluation per interval across workers). 0 = use cron: python -m scripts.run_alerts
ALERT_EVAL_INTERVAL_MINUTES=5
# External delivery (secret; backend host env only). Empty = incidents are persisted only.
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# --- job recommendations (server side only) ---------------------------------
# JSearch via OpenWeb Ninja: https://app.openwebninja.com  (x-api-key, starts with ak_)
JSEARCH_API_KEY=
# SerpApi Google Jobs engine: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Wasl's own hard caps per calendar month, kept below the free quotas so paid usage is never triggered
JOBS_JSEARCH_MONTHLY_LIMIT=150
JOBS_SERPAPI_MONTHLY_LIMIT=200
JOBS_SERPAPI_RESERVE=15
JOBS_CACHE_HOURS=24
JOBS_REFRESH_COOLDOWN_MINUTES=15
JOBS_REFRESHES_PER_DAY=6
JOBS_LISTING_MAX_AGE_DAYS=45
